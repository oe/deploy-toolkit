{
  "name": "deploy-toolkit",
  "version": "0.1.1",
  "description": "A toolkit make it easy(with plain config) to manipulate(upload/download/exec command) server via ssh, can be used to deploy stuffs or CI/CD",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "repository": "https://github.com/evecalm/deploy-toolkit.git",
  "author": "Saiya",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node test/index.ts",
    "clean": "rimraf ./dist",
    "prebuild": "yarn run lint && yarn run clean",
    "build": "tsc",
    "release": "yarn build && yarn publish",
    "lint-message": "echo 'lint code before commit'",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "deploy",
    "ssh",
    "ci/cd",
    "upload"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "yarn run lint-message && yarn run lint"
    }
  },
  "dependencies": {
    "@types/glob": "^7.2.0",
    "glob": "^7.2.0",
    "node-ssh": "^12.0.2",
    "ssh2-streams": "^0.4.10"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.13",
    "@types/node": "^17.0.7",
    "@typescript-eslint/eslint-plugin": "^5.8.1",
    "@typescript-eslint/parser": "^5.8.1",
    "eslint": "^8.6.0",
    "fs-extra": "^10.0.0",
    "husky": "^1.1.4",
    "rimraf": "^3.0.2",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.4"
  },
  "engines": {
    "node": ">=8"
  }
}
