{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": true,
    "strict": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es2022",
    "allowJs": false,
    "lib": ["es2022"],
    "types": ["node"]
  },
  "include": [
    "./src/**/*.ts"
  ]
}
