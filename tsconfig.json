{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es6",
    "allowJs": false,
    "baseUrl": "./",
    "lib": [
      "dom",
      "es6"
    ]
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "./test",
    "./dist"
  ]
}