{
  "compilerOptions": {
    "sourceMap": false,
    "strict": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "es2022",
    "allowJs": false,
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "./src/**/*.ts"
  ]
}
